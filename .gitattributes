# Normalizar todos los archivos de texto a LF en el repo
* text=auto eol=lf

# Python
*.py text eol=lf
*.pyi text eol=lf

# JavaScript / TypeScript / Next.js
*.js text eol=lf
*.jsx text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.mjs text eol=lf
*.cjs text eol=lf
*.json text eol=lf
*.css text eol=lf

# Web
*.html text eol=lf
*.htm text eol=lf
*.md text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.toml text eol=lf
*.ini text eol=lf
*.cfg text eol=lf
*.txt text eol=lf
*.env text eol=lf
*.env.example text eol=lf

# Scripts — mantener CRLF en Windows para .bat
*.bat text eol=crlf
*.cmd text eol=crlf

# Shell scripts
*.sh text eol=lf

# Binarios — sin conversión
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.svg binary
*.woff binary
*.woff2 binary
*.ttf binary
*.eot binary
*.node binary
*.exe binary
*.dll binary
